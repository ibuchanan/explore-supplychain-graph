{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:workdown:frontmatter:1",
  "title": "Workdown version 1 Frontmatter",
  "description": "Parsed YAML mapping. The document reader must additionally enforce quoted strings, unique keys, no tags, anchors, aliases or additional YAML documents, source identity alignment and timestamp equality.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "type",
    "source_id",
    "title",
    "resource",
    "work_type",
    "generated",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "workdown" },
    "format_version": { "const": 1 },
    "type": { "const": "WorkItem" },
    "source_id": { "$ref": "#/definitions/text" },
    "title": { "$ref": "#/definitions/text" },
    "resource": { "$ref": "#/definitions/url" },
    "work_type": { "$ref": "#/definitions/text" },
    "key": { "$ref": "#/definitions/text" },
    "work_status": { "$ref": "#/definitions/status" },
    "resolution": { "$ref": "#/definitions/text" },
    "priority": { "$ref": "#/definitions/text" },
    "tags": {
      "type": "array",
      "items": { "$ref": "#/definitions/text" }
    },
    "created_at": { "$ref": "#/definitions/timestamp" },
    "updated_at": { "$ref": "#/definitions/timestamp" },
    "start_date": { "$ref": "#/definitions/date" },
    "due_date": { "$ref": "#/definitions/date" },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": { "by": { "const": "workdown/1" } }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resource", "title"],
        "properties": {
          "id": { "$ref": "#/definitions/text" },
          "resource": { "$ref": "#/definitions/url" },
          "title": { "$ref": "#/definitions/text" },
          "last_modified": { "$ref": "#/definitions/timestamp" }
        }
      }
    },
    "parent": { "$ref": "#/definitions/item" },
    "children": { "type": "array", "items": { "$ref": "#/definitions/item" } }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "url": { "type": "string", "pattern": "^https://[^/?#\\s]+(?:[/?#].*)?$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "category": { "enum": ["todo", "in_progress", "done"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "resource", "work_type"],
      "properties": {
        "source_id": { "$ref": "#/definitions/text" },
        "title": { "$ref": "#/definitions/text" },
        "resource": { "$ref": "#/definitions/url" },
        "work_type": { "$ref": "#/definitions/text" },
        "key": { "$ref": "#/definitions/text" },
        "work_status": { "$ref": "#/definitions/status" },
        "resolution": { "$ref": "#/definitions/text" }
      }
    }
  }
}

{
  "name": "explore-supplychain-graph",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "license": "Apache-2.0",
  "author": "ibuchanan",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "contract:generate": "node scripts/generate-contract.mjs",
    "lint:check:contract": "node scripts/generate-contract.mjs --check",
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "run-p --npm-path npm --print-label \"{lint,test,size:check,pack:check}\"",
    "clean": "rm -rf dist",
    "forge:deploy": "cmd=$(fence-rider deploy -e development -- --non-interactive --approve MAJOR_VERSION_RULE) && sh -c \"$cmd\" sh",
    "forge:install": "cmd=$(fence-rider install -- --confirm-scopes --non-interactive) && sh -c \"$cmd\" sh",
    "forge:register": "forge register",
    "forge:uninstall": "cmd=$(fence-rider uninstall) && sh -c \"$cmd\" sh",
    "forge:upgrade": "cmd=$(fence-rider install -- --upgrade --confirm-scopes --non-interactive) && sh -c \"$cmd\" sh",
    "forge:variables:set": "fence-rider variables",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "run-p --npm-path npm --print-label \"lint:check:*\"",
    "lint:check:biome": "biome lint",
    "lint:check:forge": "forge lint --approve MAJOR_VERSION_RULE",
    "lint:check:format": "npm run format:check",
    "lint:check:prelint": "ast-grep scan --globs '!specs/**' --globs '!node_modules/**' --config ./node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml",
    "lint:check:typecheck": "npm run typecheck",
    "lint:docs": "markdownlint-cli2 \"**/*.md\" && cspell lint \"**/*.md\"",
    "lint:fix": "biome lint --write",
    "prepare": "lefthook install || true && npm run skill:link-wrangler",
    "size:check": "npm run build && size-limit",
    "skill:link-wrangler": "link-skills --package skill-wrangler",
    "test": "vitest run --passWithNoTests",
    "test:deployed": "secretspec run --scope '' -- env WORKDOWN_DEPLOYED_TEST=1 vitest run test/discovery.deployed.test.ts",
    "test:deployed:publication": "secretspec run --scope '' -- env WORKDOWN_DEPLOYED_TEST=1 WORKDOWN_PUBLICATION_TEST=1 vitest run test/publication.deployed.test.ts --silent=false",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "todo": "git grep -n -I -F TO\"DO\" -- .; status=$?; if [ \"$status\" -eq 1 ]; then echo \"No TO\"\"DO markers found.\"; elif [ \"$status\" -ne 0 ]; then exit \"$status\"; fi",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types",
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge-ahead/rpc": "github:ibuchanan/forge-ahead-rpc",
    "@forge/api": "^8.5.0",
    "@forge/events": "^3.0.10",
    "@forge/kvs": "^2.1.2",
    "@forge/teamwork-graph": "^5.4.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51",
    "@biomejs/biome": "2.6.7",
    "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
    "@json-schema-tools/meta-schema": "^1.8",
    "@open-rpc/meta-schema": "^1.14",
    "@size-limit/file": "^14.3",
    "@types/node": "24",
    "@vitest/coverage-v8": "^5.1",
    "agent-skills-toolkit": "github:ibuchanan/agent-skills-toolkit",
    "cspell": "^10.5",
    "fast-check": "^4.10",
    "fence-rider": "github:ibuchanan/ranch-rig-fence-rider",
    "git-cliff": "^2.14",
    "lefthook": "^2.2",
    "markdownlint-cli2": "^0.24",
    "npm-run-all2": "^9.0",
    "size-limit": "^14.3",
    "skill-wrangler": "github:ibuchanan/ranch-hand-skill-wrangler.git",
    "typescript": "^5.9",
    "vitest": "^5.1"
  },
  "size-limit": [
    {
      "name": "Forge app bundle",
      "path": "dist/**/*.js",
      "limit": "45 kB"
    }
  ]
}
